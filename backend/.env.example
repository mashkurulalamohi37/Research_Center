PROJECT_NAME="Advanced Intelligent Research Center API"
API_V1_STR="/api/v1"
SECRET_KEY="airc_super_secret_production_jwt_signing_key_change_in_prod"
REFRESH_SECRET_KEY="airc_super_secret_refresh_token_key_change_in_prod"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=7

# Default SQLite database for instant local run without external Postgres daemon,
# or PostgreSQL connection string: postgresql+asyncpg://airc_user:airc_password@localhost:5432/airc_db
DATABASE_URL="sqlite+aiosqlite:///./airc.db"

CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://localhost:8080","http://127.0.0.1:5173"]
ENVIRONMENT="development"
